#!/usr/bin/env bash
# ----------------------------------------------------------------------------
# Copra Protocol - Pre-commit Git Hook
# Validates code formatting, tests, and secret leaks before every commit
# ----------------------------------------------------------------------------

set -e

echo "🥥 [Copra Hook] Running pre-commit validation..."

# 1. Gitleaks Secret Detection
if command -v gitleaks >/dev/null 2>&1; then
    echo "🔍 [Copra Hook] Checking for secret leaks with Gitleaks..."
    gitleaks protect --config .gitleaks.toml --staged --verbose
    echo "✅ [Copra Hook] No secrets detected."
else
    echo "⚠️  [Copra Hook] gitleaks CLI not found in PATH; skipping local secret scan."
fi

# 2. Forge Code Formatting Check
if command -v forge >/dev/null 2>&1; then
    echo "📐 [Copra Hook] Checking Solidity code formatting with forge fmt..."
    if ! forge fmt --check; then
        echo "❌ [Copra Hook] Code formatting check failed! Run 'forge fmt' to fix."
        exit 1
    fi
    echo "✅ [Copra Hook] Code formatting clean."
fi

echo "🚀 [Copra Hook] All pre-commit checks passed!"
exit 0
